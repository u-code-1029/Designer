{
  "DrillFlow": {
    "Language": "Auto",
    "Theme": "System",
    "ValidateWorkflowOnEveryChange": true,
    "RealtimeVideo": {
      "Enabled": false,
      "SignalR": {
        "HubEndpoint": "",
        "StreamMethod": "StreamFrames",
        "Transport": "LongPolling",
        "ServerTimeoutSeconds": 30.0,
        "KeepAliveIntervalSeconds": 15.0
      },
      "Authentication": {
        "Mode": "None",
        "CredentialName": "",
        "TokenEnvironmentVariable": "DRILLFLOW_SIGNALR_JWT"
      },
      "Retry": {
        "Enabled": true,
        "InitialConnectMaximumAttempts": 5,
        "ReconnectDelaysSeconds": [ 0.0, 2.0, 10.0, 30.0 ]
      },
      "Frames": {
        "MaximumFrameBytes": 8388608,
        "BufferCapacity": 1
      }
    }
  },
  "EquipmentCommunication": {
    "ExchangeDirectory": "C:\\DrillFlow\\Exchange",
    "LiveImageDirectory": "C:\\DrillFlow\\Exchange\\.drillflow-live",
    "RequestFileName": "request.xml",
    "ResponseFileName": "response.xml",
    "EquipmentRequestLifecycle": "RetainUntilOverwritten",
    "ApplicationRequestLifecycle": "DeleteAfterResponse",
    "ApplicationResponseLifecycle": "DeleteAfterRead",
    "ResponseTimeout": "00:00:30",
    "RetryEnabled": false,
    "MaximumRetryCount": 1,
    "RetryDelay": "00:00:01",
    "PollingInterval": "00:00:00.050",
    "RequestPublishDelay": "00:00:00.100",
    "StableReadDelay": "00:00:00.050"
  },
  "CorrelationIdStore": {}
}
