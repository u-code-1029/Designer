<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DrillAccentColor">#0F6CBD</Color>
    <SolidColorBrush x:Key="DrillAccentBrush" Color="{StaticResource DrillAccentColor}" />
    <SolidColorBrush x:Key="DrillAccentSoftBrush" Color="#E7F1FA" />
    <SolidColorBrush x:Key="DrillSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DrillCanvasBrush" Color="#FFF6F7F9" />
    <SolidColorBrush x:Key="DrillSubtleBrush" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="DrillBorderBrush" Color="#FFE1E5EA" />
    <SolidColorBrush x:Key="DrillTextBrush" Color="#FF1F2328" />
    <SolidColorBrush x:Key="DrillSecondaryTextBrush" Color="#FF626B75" />
    <SolidColorBrush x:Key="DrillSuccessBrush" Color="#FF107C10" />
    <SolidColorBrush x:Key="DrillWarningBrush" Color="#FFC19C00" />
    <SolidColorBrush x:Key="DrillDangerBrush" Color="#FFC42B1C" />

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DrillSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DrillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DrillTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DrillTextBrush}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DrillSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DrillSecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ToolboxItemStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DrillSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DrillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DrillAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DrillAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActionCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DrillSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DrillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Arrow" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DrillAccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{StaticResource DrillAccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DrillSuccessBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsNodeEnabled}" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InsertionMarkerStyle" TargetType="Border">
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,2,0,0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{DynamicResource SelectInsertionPosition}" />
    </Style>

    <Style x:Key="ToolbarSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{StaticResource DrillBorderBrush}" />
    </Style>
</ResourceDictionary>
