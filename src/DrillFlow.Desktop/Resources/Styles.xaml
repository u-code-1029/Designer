<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="DrillAccentBrush" Color="{DynamicResource AccentFillColorDefault}" />
    <SolidColorBrush x:Key="DrillAccentSoftBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="DrillSurfaceBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="DrillOpaqueSurfaceBrush" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
    <SolidColorBrush x:Key="DrillOpaqueSelectedSurfaceBrush" Color="{DynamicResource SolidBackgroundFillColorTertiary}" />
    <SolidColorBrush x:Key="DrillCanvasBrush" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="DrillSubtleBrush" Color="{DynamicResource LayerFillColorDefault}" />
    <SolidColorBrush x:Key="DrillBorderBrush" Color="{DynamicResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="DrillTextBrush" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="DrillSecondaryTextBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DrillSuccessBrush" Color="{DynamicResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="DrillWarningBrush" Color="{DynamicResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="DrillDangerBrush" Color="{DynamicResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="DrillDangerSoftBrush"
                     Color="{DynamicResource SystemFillColorCritical}"
                     Opacity="0.12" />

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DrillSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DrillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DrillTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DrillTextBrush}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource DrillSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DrillSecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ToolboxItemStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DrillSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DrillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DrillAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DrillAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActionCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DrillOpaqueSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DrillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Arrow" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DrillAccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{DynamicResource DrillOpaqueSelectedSurfaceBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DrillSuccessBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DrillDangerBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{DynamicResource DrillDangerSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InsertionMarkerStyle" TargetType="Border">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,2,0,0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{DynamicResource SelectInsertionPosition}" />
    </Style>

    <Style x:Key="ToolbarSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DrillBorderBrush}" />
    </Style>
</ResourceDictionary>
