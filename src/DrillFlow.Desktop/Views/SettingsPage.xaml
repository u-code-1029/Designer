<Page x:Class="DrillFlow.Desktop.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:DrillFlow.Desktop.Converters"
      Background="{DynamicResource DrillCanvasBrush}"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      ShowsNavigationUI="False">
    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
        <Grid Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitleStyle}" />

            <ui:Card Grid.Row="2" Padding="22">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AppearanceSettings}" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Theme}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox SelectedValue="{Binding Theme}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}" />
                                <ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}" />
                                <ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Language}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox SelectedValue="{Binding Language}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="Auto" Content="{DynamicResource LanguageAuto}" />
                                <ComboBoxItem Tag="ko-KR" Content="{DynamicResource LanguageKorean}" />
                                <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="{DynamicResource ValidateWorkflowOnEveryChange}"
                              IsChecked="{Binding ValidateWorkflowOnEveryChange, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              ToolTip="{DynamicResource ValidateWorkflowOnEveryChangeHint}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="4" Padding="22" IsEnabled="{Binding CanEditSettings}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource CommunicationSettings}" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="{DynamicResource ExchangeFolder}" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ExchangeFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="C:\Equipment\Exchange  /  \\server\share\exchange" />
                        <ui:Button Grid.Column="2"
                                   Content="{DynamicResource Browse}"
                                   Command="{Binding BrowseFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderSearch24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Grid.Column="4"
                                   Command="{Binding OpenFolderCommand}"
                                   ToolTip="{DynamicResource OpenExchangeFolder}"
                                   AutomationProperties.Name="{DynamicResource OpenExchangeFolder}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <TextBlock Text="{DynamicResource LiveImageFolder}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding LiveImageFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource LiveImageFolderHint}" />
                        <ui:Button Grid.Column="2"
                                   Content="{DynamicResource Browse}"
                                   Command="{Binding BrowseLiveImageFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderSearch24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Grid.Column="4"
                                   Command="{Binding OpenLiveImageFolderCommand}"
                                   ToolTip="{DynamicResource OpenLiveImageFolder}"
                                   AutomationProperties.Name="{DynamicResource OpenLiveImageFolder}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                    <TextBlock Text="{DynamicResource LiveImageFolderHint}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource RequestFileName}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding RequestFileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource ResponseFileName}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ResponseFileName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource EquipmentRequestHandling}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox SelectedValue="{Binding EquipmentRequestHandling}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="EquipmentDeletesAfterRead" Content="{DynamicResource DeleteAfterRead}" />
                                <ComboBoxItem Tag="RetainUntilOverwritten" Content="{DynamicResource RetainRequestAndOverwrite}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource AppRequestHandling}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox SelectedValue="{Binding AppRequestHandling}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="DeleteAfterResponse" Content="{DynamicResource DeleteAfterResponse}" />
                                <ComboBoxItem Tag="RetainUntilOverwritten" Content="{DynamicResource RetainRequestAndOverwrite}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource AppResponseHandling}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox SelectedValue="{Binding AppResponseHandling}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="DeleteAfterRead" Content="{DynamicResource DeleteAfterRead}" />
                                <ComboBoxItem Tag="RetainUntilOverwritten" Content="{DynamicResource RetainAndOverwrite}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource ResponseTimeout}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ResponseTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource PollingInterval}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource RequestPublishDelay}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding RequestPublishDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="{DynamicResource RetryEnabled}"
                              IsChecked="{Binding RetryEnabled}"
                              Margin="0,0,0,10" />
                    <ui:InfoBar Title="{DynamicResource RetryWarning}"
                                Severity="Warning"
                                IsClosable="False"
                                IsOpen="{Binding RetryEnabled}"
                                Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource MaximumRetryCount}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding MaximumRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding RetryEnabled}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource RetryInterval}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding RetryIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding RetryEnabled}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource DrillDangerBrush}"
                               Margin="0,0,0,10"
                               Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{DynamicResource SaveSettings}"
                                   Command="{Binding SaveCommand}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Save24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{DynamicResource TestConnection}"
                                   Command="{Binding TestConnectionCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PlugConnected24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Grid.Row="6"
                        IsOpen="True"
                        IsClosable="False"
                        Title="{Binding StatusMessage}" />
        </Grid>
    </ScrollViewer>
</Page>
