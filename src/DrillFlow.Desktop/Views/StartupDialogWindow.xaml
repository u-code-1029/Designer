<ui:FluentWindow x:Class="DrillFlow.Desktop.Views.StartupDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DrillFlow Designer"
                 Width="600"
                 Height="300"
                 MinWidth="520"
                 MinHeight="260"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None">
    <Grid Background="{StaticResource DrillCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="DrillFlow Designer"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="False"
                     CanMaximize="False" />

        <Border Grid.Row="1"
                Margin="24"
                Background="{StaticResource DrillSurfaceBrush}"
                BorderBrush="{StaticResource DrillBorderBrush}"
                BorderThickness="1"
                CornerRadius="8" />

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.RowSpan="2"
                              IsDisableSiblingsEnabled="True"
                              Panel.ZIndex="100" />
    </Grid>
</ui:FluentWindow>
