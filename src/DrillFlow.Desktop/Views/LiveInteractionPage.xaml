<Page x:Class="DrillFlow.Desktop.Views.LiveInteractionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DrillFlow.Desktop.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="{DynamicResource DrillCanvasBrush}"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      ShowsNavigationUI="False"
      PreviewKeyDown="Page_PreviewKeyDown"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ControlTemplate x:Key="ImageVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Path Data="M2.5,4.5 H17.5 V15.5 H2.5 Z M4.5,13 L8,9.5 10.5,12 13.5,8.5 16.5,12"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                    <Ellipse Canvas.Left="12.3"
                             Canvas.Top="6.1"
                             Width="2.4"
                             Height="2.4"
                             Fill="{TemplateBinding Foreground}" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
        <ControlTemplate x:Key="PlayVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Path Data="M6,3.8 L16.8,10 L6,16.2 Z"
                      Fill="{TemplateBinding Foreground}"
                      StrokeLineJoin="Round" />
            </Viewbox>
        </ControlTemplate>
        <ControlTemplate x:Key="StopVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Rectangle Width="11"
                           Height="11"
                           RadiusX="1.5"
                           RadiusY="1.5"
                           Fill="{TemplateBinding Foreground}" />
            </Viewbox>
        </ControlTemplate>
        <ControlTemplate x:Key="CancelRequestVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Rectangle Canvas.Left="3.75"
                               Canvas.Top="3.75"
                               Width="12.5"
                               Height="12.5"
                               RadiusX="2"
                               RadiusY="2"
                               Stroke="{TemplateBinding Foreground}"
                               StrokeThickness="1.5" />
                    <Path Data="M7,7 L13,13 M13,7 L7,13"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
        <ControlTemplate x:Key="CaptureVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Ellipse Canvas.Left="3"
                             Canvas.Top="3"
                             Width="14"
                             Height="14"
                             Stroke="{TemplateBinding Foreground}"
                             StrokeThickness="1.5" />
                    <Ellipse Canvas.Left="6.5"
                             Canvas.Top="6.5"
                             Width="7"
                             Height="7"
                             Fill="{TemplateBinding Foreground}" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
        <ControlTemplate x:Key="FolderVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Path Data="M2.5,6.25 L2.5,15.5 L17.5,15.5 L17.5,7.5 L9.2,7.5 L7.4,5.25 L2.5,5.25 Z"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent" />
            </Viewbox>
        </ControlTemplate>
    </Page.Resources>

    <Grid Margin="16" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="EquipmentMonitorSplitterRow" Height="0" />
            <RowDefinition x:Name="EquipmentMonitorRow" Height="0" MinHeight="0" MaxHeight="420" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LiveInteractionTitle}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Width="38"
                               Height="36"
                               Padding="0"
                               Command="{Binding StartCommand}"
                               Appearance="Primary"
                               Margin="0,0,4,0"
                               ToolTip="{DynamicResource LiveStart}"
                               AutomationProperties.Name="{DynamicResource LiveStart}">
                        <Control Width="18"
                                 Height="18"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                 Template="{StaticResource PlayVectorIconTemplate}" />
                    </ui:Button>
                    <ui:Button Width="38"
                               Height="36"
                               Padding="0"
                               Command="{Binding StopCommand}"
                               Margin="0,0,4,0"
                               ToolTip="{DynamicResource LiveStop}"
                               AutomationProperties.Name="{DynamicResource LiveStop}">
                        <Control Width="17"
                                 Height="17"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                 Template="{StaticResource StopVectorIconTemplate}" />
                    </ui:Button>
                    <ui:Button Width="38"
                               Height="36"
                               Padding="0"
                               Command="{Binding CancelNonLiveRequestCommand}"
                               Margin="0,0,4,0"
                               ToolTip="{DynamicResource LiveCancelNonLiveRequestHint}"
                               AutomationProperties.Name="{DynamicResource LiveCancelNonLiveRequest}">
                        <Control Width="18"
                                 Height="18"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                 Template="{StaticResource CancelRequestVectorIconTemplate}" />
                    </ui:Button>

                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" Margin="7,4" />

                    <ui:Button Width="38"
                               Height="36"
                               Padding="0"
                               Command="{Binding CaptureCommand}"
                               Margin="0,0,4,0"
                               ToolTip="{DynamicResource LiveCapture}"
                               AutomationProperties.Name="{DynamicResource LiveCapture}">
                        <Control Width="18"
                                 Height="18"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                 Template="{StaticResource CaptureVectorIconTemplate}" />
                    </ui:Button>

                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" Margin="7,4" />

                    <ui:Button Width="38"
                               Height="36"
                               Padding="0"
                               Command="{Binding OpenExchangeFolderCommand}"
                               Margin="0,0,4,0"
                               ToolTip="{DynamicResource OpenExchangeFolder}"
                               AutomationProperties.Name="{DynamicResource OpenExchangeFolder}">
                        <Control Width="18"
                                 Height="18"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                 Template="{StaticResource FolderVectorIconTemplate}" />
                    </ui:Button>
                    <ui:Button Width="38"
                               Height="36"
                               Padding="0"
                               Command="{Binding GenerateSingleFrameResponseCommand}"
                               Margin="0,0,8,0"
                               ToolTip="{DynamicResource LiveGenerateSingleFrameResponseHint}"
                               AutomationProperties.Name="{DynamicResource LiveGenerateSingleFrameResponse}">
                        <Control Width="18"
                                 Height="18"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                 Template="{StaticResource ImageVectorIconTemplate}" />
                    </ui:Button>
                    <ui:ToggleSwitch Width="42"
                                     IsChecked="{Binding IsContinuousResponseGenerationEnabled, Mode=TwoWay}"
                                     OffContent=""
                                     OnContent=""
                                     ToolTip="{DynamicResource LiveContinuousResponseGenerationHint}"
                                     AutomationProperties.Name="{DynamicResource LiveContinuousResponseGeneration}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="4"
                    Padding="10,5"
                    CornerRadius="14"
                    Background="{DynamicResource DrillAccentSoftBrush}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing Width="16"
                                     Height="16"
                                     Margin="0,0,7,0"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource DrillAccentBrush}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DrillSecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource DrillSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource DrillTextBrush}"
                               VerticalAlignment="Center"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="12,0,0,0"
                               Foreground="{DynamicResource DrillSecondaryTextBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{DynamicResource LiveFrameCount}" />
                        <Run Text=" " />
                        <Run Text="{Binding FrameCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  ·  " />
                        <Run Text="{DynamicResource LiveLastFrame}" />
                        <Run Text=" " />
                        <Run Text="{Binding LastFrameAtText, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="360" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12,9"
                            BorderBrush="{DynamicResource DrillBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox Content="{DynamicResource LiveShowOmNavigationImage}"
                                      IsChecked="{Binding IsOmPanelVisible, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,14,0" />
                            <ui:Button Command="{Binding AcquireOmImageCommand}"
                                       ToolTip="{DynamicResource LiveAcquireOmImageHint}"
                                       AutomationProperties.Name="{DynamicResource LiveAcquireOmImage}">
                                <StackPanel Orientation="Horizontal">
                                    <Control Width="18"
                                             Height="18"
                                             Margin="0,0,7,0"
                                             Foreground="{DynamicResource DrillTextBrush}"
                                             Template="{StaticResource ImageVectorIconTemplate}" />
                                    <TextBlock Text="{DynamicResource LiveAcquireOmImage}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Margin="0,0,6,0"
                              MinHeight="260"
                              Background="{DynamicResource DrillOpaqueSurfaceBrush}"
                              ClipToBounds="True"
                              Visibility="{Binding IsOmPanelVisible, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding OmImageSource}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Border IsHitTestVisible="False"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="28"
                                    CornerRadius="10"
                                    Background="{DynamicResource DrillSubtleBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOmImage}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Control Width="38"
                                             Height="38"
                                             Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                             Template="{StaticResource ImageVectorIconTemplate}" />
                                    <TextBlock Text="{DynamicResource LiveNoOmImage}"
                                               Margin="0,12,0,0"
                                               Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border IsHitTestVisible="False"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Padding="10,6"
                                    CornerRadius="6"
                                    Background="#B0000000">
                                <TextBlock Text="{DynamicResource LiveOmNavigationImage}"
                                           Foreground="White"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid x:Name="ImageViewport"
                              MinHeight="260"
                              Background="{DynamicResource DrillOpaqueSurfaceBrush}"
                              MouseWheel="ImageViewport_MouseWheel"
                              ClipToBounds="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                    <Setter Property="Margin" Value="6,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOmPanelVisible}" Value="False">
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                    <Image x:Name="LiveImage"
                           Source="{Binding LiveImageSource}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           MouseLeftButtonDown="LiveImage_MouseLeftButtonDown"
                           PreviewMouseRightButtonDown="LiveImage_PreviewMouseRightButtonDown"
                           ContextMenuOpening="LiveImage_ContextMenuOpening"
                           SizeChanged="LiveImage_SizeChanged"
                           Cursor="Cross">
                        <Image.ContextMenu>
                            <ContextMenu Closed="LiveImageContextMenu_Closed">
                                <MenuItem x:Name="MoveHereMenuItem"
                                          Header="{DynamicResource LiveMoveHere}"
                                          Click="MoveHereMenuItem_Click"
                                          AutomationProperties.Name="{DynamicResource LiveMoveHere}" />
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>

                    <Border IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28"
                            CornerRadius="10"
                            Background="{DynamicResource DrillSubtleBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Control Width="38"
                                     Height="38"
                                     Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                     Template="{StaticResource ImageVectorIconTemplate}" />
                            <TextBlock Text="{DynamicResource LiveNoImage}"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="12,7"
                            CornerRadius="7"
                            Background="#CC202020"
                            Visibility="{Binding IsFrameCalibrationPending, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource LiveFrameCalibrationPending}"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Canvas x:Name="TargetOverlay" IsHitTestVisible="False">
                        <Ellipse x:Name="TargetCircle"
                                 Width="28"
                                 Height="28"
                                 Stroke="{DynamicResource DrillDangerBrush}"
                                 StrokeThickness="2"
                                 Fill="#22FF3344"
                                 Visibility="Collapsed" />
                        <Line x:Name="TargetHorizontal"
                              X1="-18" X2="18" Y1="0" Y2="0"
                              Stroke="{DynamicResource DrillDangerBrush}"
                              StrokeThickness="2"
                              Visibility="Collapsed" />
                        <Line x:Name="TargetVertical"
                              X1="0" X2="0" Y1="-18" Y2="18"
                              Stroke="{DynamicResource DrillDangerBrush}"
                              StrokeThickness="2"
                              Visibility="Collapsed" />
                    </Canvas>

                    <Border VerticalAlignment="Bottom"
                            Margin="12"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#B0000000"
                            IsHitTestVisible="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource LiveDoubleClickHint}"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ImageDimensionsText}"
                                       Foreground="#CCFFFFFF"
                                       Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                    <Border IsHitTestVisible="False"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#B0000000">
                        <TextBlock Text="{DynamicResource LiveCcdCameraImage}"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                    </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ui:Card>

            <ScrollViewer Grid.Column="2"
                          CanContentScroll="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:CardExpander Grid.Row="5"
                                     Header="{DynamicResource LiveFrameMagnification}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LiveHorizontalFieldWidth}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0"
                                           Width="36"
                                           Height="34"
                                           Padding="0"
                                           Command="{Binding ZoomFrameOutCommand}"
                                           ToolTip="{DynamicResource LiveZoomOutHint}"
                                           AutomationProperties.Name="{DynamicResource LiveZoomOutHint}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ZoomOut24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <TextBox Grid.Column="2"
                                         Text="{Binding HorizontalFieldWidthText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <ComboBox Grid.Column="4"
                                          SelectedValue="{Binding HorizontalFieldWidthUnit}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="m" Content="m" />
                                    <ComboBoxItem Tag="mm" Content="mm" />
                                    <ComboBoxItem Tag="um" Content="µm" />
                                    <ComboBoxItem Tag="nm" Content="nm" />
                                </ComboBox>
                                <ui:Button Grid.Column="6"
                                           Width="36"
                                           Height="34"
                                           Padding="0"
                                           Command="{Binding ZoomFrameInCommand}"
                                           ToolTip="{DynamicResource LiveZoomInHint}"
                                           AutomationProperties.Name="{DynamicResource LiveZoomInHint}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ZoomIn24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <TextBlock Text="{Binding HorizontalFieldWidthValidationMessage}"
                                       Foreground="{DynamicResource DrillDangerBrush}"
                                       FontSize="12"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource LiveHorizontalFieldWidthHint}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource LiveIntegrationFrameCount}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,14,0,0" />
                            <ComboBox ItemsSource="{Binding IntegrationFrameCountOptions}"
                                      SelectedItem="{Binding IntegrationFrameCount, Mode=TwoWay}" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="2"
                                     Header="{DynamicResource LiveStageControl}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="move_mode"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding MoveModeOptions}"
                                      Text="{Binding StageMoveMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="stage_x (m)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding StageInputXText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="stage_y (m)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding StageInputYText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding StageMoveValidationMessage}"
                                       Foreground="{DynamicResource DrillDangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <ui:Button Content="{DynamicResource LiveExecuteStageMove}"
                                       Command="{Binding ExecuteStageMoveCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Left"
                                       Margin="0,12,0,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="3"
                                     Header="{DynamicResource LiveCameraControl}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="move_mode"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding MoveModeOptions}"
                                      Text="{Binding CameraMoveMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="camera_x (m)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding CameraInputXText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="camera_y (m)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding CameraInputYText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding CameraMoveValidationMessage}"
                                       Foreground="{DynamicResource DrillDangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <ui:Button Content="{DynamicResource LiveExecuteCameraMove}"
                                       Command="{Binding ExecuteCameraMoveCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Left"
                                       Margin="0,12,0,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Text="{DynamicResource LiveCameraPosition}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,14,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="current_camera_x"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding CameraXText}" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="current_camera_y"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding CameraYText}" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="4"
                                     Header="{DynamicResource LiveLensControl}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="lens_mode"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding LensModeOptions}"
                                      Text="{Binding LensMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True" />
                            <TextBlock Text="{DynamicResource LiveLensNoChangeHint}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <ui:Button Content="{DynamicResource LiveExecuteLens}"
                                       Command="{Binding ExecuteLensCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Left"
                                       Margin="0,12,0,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Text="current_lens_mode"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="{Binding CurrentLensMode}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="7"
                                     Header="{DynamicResource LiveFocusControl}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="hfw (m)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FocusHfwText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="range (m)"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,10,0,0" />
                            <TextBox Text="{Binding FocusRangeText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="steps"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,10,0,0" />
                            <TextBox Text="{Binding FocusStepsText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding FocusValidationMessage}"
                                       Foreground="{DynamicResource DrillDangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <ui:Button Content="{DynamicResource LiveExecuteFocus}"
                                       Command="{Binding ExecuteFocusCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Left"
                                       Margin="0,12,0,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Text="z_to_sharpness_2d"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="{Binding FocusResultText}"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                            <Border Height="240"
                                    Margin="0,10,0,0"
                                    Padding="4"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource DrillBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource DrillOpaqueSurfaceBrush}">
                                <Grid>
                                    <controls:FocusScatterChart Points="{Binding FocusSamples}"
                                                                AxisBrush="{DynamicResource DrillSecondaryTextBrush}"
                                                                GridBrush="{DynamicResource DrillBorderBrush}"
                                                                PointBrush="{DynamicResource DrillAccentBrush}"
                                                                TextBrush="{DynamicResource DrillSecondaryTextBrush}"
                                                                AutomationProperties.Name="{DynamicResource LiveFocusChartAxes}" />
                                    <TextBlock Text="{DynamicResource LiveFocusChartEmpty}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFocusSamples}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Text="{DynamicResource LiveFocusChartAxes}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,6,0,0"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="8"
                                     Header="{DynamicResource LiveAcbControl}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="hfw (m)"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding HorizontalFieldWidthMetres, StringFormat={}{0:0.########E+0} m}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource LiveAcbHfwHint}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <ui:Button Content="{DynamicResource LiveExecuteAcb}"
                                       Command="{Binding ExecuteAutoContrastBrightnessCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Left"
                                       Margin="0,12,0,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Text="{DynamicResource LiveLatestResult}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="{Binding AutoContrastBrightnessResultText}"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="6"
                                     Header="{DynamicResource LivePixelCalibration}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox Content="{DynamicResource LiveLinkPixelPitchToHfw}"
                                      IsChecked="{Binding IsPixelPitchLinkedToHorizontalFieldWidth, Mode=TwoWay}"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource LiveLinkPixelPitchToHfwHint}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,10" />
                            <TextBlock Text="{DynamicResource LivePixelPitch}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding PixelPitchText, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2"
                                          SelectedValue="{Binding PixelPitchUnit}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="m" Content="m" />
                                    <ComboBoxItem Tag="mm" Content="mm" />
                                    <ComboBoxItem Tag="um" Content="µm" />
                                    <ComboBoxItem Tag="nm" Content="nm" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{Binding PixelPitchValidationMessage}"
                                       Foreground="{DynamicResource DrillDangerBrush}"
                                       FontSize="12"
                                       Margin="0,6,0,0" />

                            <CheckBox Content="{DynamicResource LiveInvertX}"
                                      IsChecked="{Binding InvertXAxis}"
                                      Margin="0,14,0,4" />
                            <CheckBox Content="{DynamicResource LiveInvertY}"
                                      IsChecked="{Binding InvertYAxis}" />
                            <ui:InfoBar Title="{DynamicResource LiveAxisConvention}"
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Margin="0,14,0,0" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="0"
                                     Header="{DynamicResource LiveStagePosition}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="stage_x"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding StageXText}"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="stage_y"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding StageYText}"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{DynamicResource DrillSecondaryTextBrush}">
                                <Run Text="correlation_id: " />
                                <Run Text="{Binding LastCorrelationId, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="1"
                                     Header="{DynamicResource LiveTargetMove}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LiveTargetPixel}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding TargetPixelText}"
                                       FontFamily="Consolas" />
                            <TextBlock Text="{DynamicResource LiveRelativeMove}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="{Binding TargetMoveText}"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Grid.Row="9"
                                     Header="{DynamicResource LiveCaptureResult}"
                                     IsExpanded="False"
                                     ContentPadding="18"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LiveSavedPath}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SavedImagePath, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap" />
                                <ui:Button Grid.Column="2"
                                           Width="38"
                                           Height="34"
                                           Padding="0"
                                           VerticalAlignment="Top"
                                           Command="{Binding OpenSavedImageCommand}"
                                           ToolTip="{DynamicResource LiveOpenSavedImage}"
                                           AutomationProperties.Name="{DynamicResource LiveOpenSavedImage}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Open24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                </Grid>
            </ScrollViewer>
        </Grid>

        <GridSplitter x:Name="EquipmentMonitorSplitter"
                      Grid.Row="5"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Visibility="Collapsed"
                      Background="Transparent" />

        <controls:EquipmentCommunicationPanel x:Name="EquipmentMonitor"
                                              Grid.Row="6"
                                              ExpandedStateChanged="EquipmentMonitor_ExpandedStateChanged" />

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:InfoBar Grid.Column="0"
                        Margin="0,0,8,0"
                        IsOpen="True"
                        IsClosable="False"
                        Title="{Binding StatusMessage}">
                <ui:InfoBar.Style>
                    <Style TargetType="ui:InfoBar">
                        <Setter Property="Severity" Value="Informational" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                <Setter Property="Severity" Value="Warning" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Severity" Value="Error" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:InfoBar.Style>
            </ui:InfoBar>
            <controls:EquipmentActivityStatus Grid.Column="1"
                                              DataContext="{Binding DataContext, ElementName=EquipmentMonitor}" />
        </Grid>
    </Grid>
</Page>
