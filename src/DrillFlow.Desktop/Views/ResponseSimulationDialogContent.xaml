<UserControl x:Class="DrillFlow.Desktop.Views.ResponseSimulationDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="560"
             MinHeight="430">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar Grid.Row="0"
                    IsOpen="{Binding HasValidationError}"
                    IsClosable="False"
                    Severity="Error"
                    Message="{Binding ValidationMessage}"
                    Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ResponseTestAction}" FontWeight="SemiBold" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding ActionSummary}" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ResponseTestActiveRequest}" FontWeight="SemiBold" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding ActiveRequestSummary}" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ResponseTestFormat}" FontWeight="SemiBold" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding PayloadFormat}" />
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource ResponseTestDestination}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Text="{Binding ResponsePath}"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" />
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource ResponseTestPayload}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Grid.Row="1"
                     Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     MinHeight="220"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</UserControl>
