<UserControl x:Class="DrillFlow.Desktop.Controls.EquipmentCommunicationPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DrillFlow.Desktop.Controls"
             xmlns:viewModels="clr-namespace:DrillFlow.Desktop.ViewModels">
    <UserControl.Resources>
        <Style x:Key="MonitorIconButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EquipmentStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource DrillSecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionState}"
                             Value="{x:Static viewModels:EquipmentScreenConnectionState.Connecting}">
                    <Setter Property="Fill" Value="{DynamicResource DrillWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}"
                             Value="{x:Static viewModels:EquipmentScreenConnectionState.Connected}">
                    <Setter Property="Fill" Value="{DynamicResource DrillSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}"
                             Value="{x:Static viewModels:EquipmentScreenConnectionState.Faulted}">
                    <Setter Property="Fill" Value="{DynamicResource DrillDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Locale-safe icons. These use vector geometry instead of private-use
             symbol-font glyphs so they render consistently on Windows 7/ko-KR. -->
        <ControlTemplate x:Key="TerminalVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Path Data="M2.5,4.5 H17.5 V16.5 H2.5 Z M5.5,8 L8,10.5 5.5,13 M10.5,13 H14.5"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="DeleteVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Path Data="M4,6 H16 M7,6 V4 H13 V6 M6,8 L7,17 H13 L14,8 M9,10 V15 M11,10 V15"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="PreviewVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Path Data="M2.5,4.5 H17.5 V15.5 H2.5 Z"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                    <Path Data="M8,7.5 L13,10 8,12.5 Z"
                          Fill="{TemplateBinding Foreground}" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="PreviewToggleVectorIconTemplate" TargetType="Control">
            <Grid>
                <Path x:Name="PlayMark"
                      Data="M6,3.5 L16,10 6,16.5 Z"
                      Fill="{TemplateBinding Foreground}"
                      Stretch="Uniform"
                      Margin="4" />
                <Path x:Name="PauseMark"
                      Data="M5,3 H8 V17 H5 Z M12,3 H15 V17 H12 Z"
                      Fill="{TemplateBinding Foreground}"
                      Stretch="Uniform"
                      Margin="4"
                      Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPreviewPlaying}" Value="True">
                    <Setter TargetName="PlayMark" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PauseMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="PopOutVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Path Data="M3,7 H12 V17 H3 Z M8,3 H17 V12 M11,3 H17 V9 M17,3 L10,10"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="PanelContent"
              Margin="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPanelExpanded, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RegionOneColumn" Width="2*" MinWidth="260" />
                <ColumnDefinition x:Name="FirstSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RegionTwoColumn" Width="2*" MinWidth="260" />
                <ColumnDefinition x:Name="SecondSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RegionThreeColumn" Width="1*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Communication, validation, and preview are independent layout regions. -->
            <Border x:Name="CommunicationRegion"
                    Grid.Column="0"
                    Background="{DynamicResource DrillSurfaceBrush}"
                    BorderBrush="{DynamicResource DrillBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid Background="{DynamicResource DrillOpaqueSurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    MinHeight="42"
                                    Padding="12,6"
                                    Background="{DynamicResource DrillSurfaceBrush}"
                                    BorderBrush="{DynamicResource DrillBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Control Grid.Column="0"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,7,0"
                                             Foreground="{DynamicResource DrillAccentBrush}"
                                             Template="{StaticResource TerminalVectorIconTemplate}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource CommunicationTerminalTitle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PendingExchangeText}"
                                               Margin="12,0,8,0"
                                               Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="3"
                                              Content="{DynamicResource CommunicationAutoScroll}"
                                              IsChecked="{Binding IsAutoScrollEnabled}"
                                              Foreground="{DynamicResource DrillTextBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />
                                    <ui:Button Grid.Column="4"
                                               Style="{StaticResource MonitorIconButtonStyle}"
                                               Command="{Binding ClearTerminalCommand}"
                                               ToolTip="{DynamicResource CommunicationClear}"
                                               AutomationProperties.Name="{DynamicResource CommunicationClear}">
                                        <Control Width="18"
                                                 Height="18"
                                                 Foreground="{DynamicResource DrillTextBrush}"
                                                 Template="{StaticResource DeleteVectorIconTemplate}" />
                                    </ui:Button>
                                </Grid>
                            </Border>

                            <ListBox x:Name="TerminalList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Entries}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:EquipmentCommunicationEntryViewModel}">
                                        <Border Padding="12,9"
                                                BorderBrush="{DynamicResource DrillBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Background="Transparent">
                                            <StackPanel>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TimestampText}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding DirectionText}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Margin="0,0,10,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource DrillAccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsResponse}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DrillSuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="action="
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource DrillSecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding Action}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource DrillAccentBrush}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="correlation_id="
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource DrillSecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding CorrelationId}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource DrillWarningBrush}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding AttemptText}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource DrillWarningBrush}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding StateText}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DrillTextBrush}" />
                                                </WrapPanel>

                                                <Button Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="0"
                                                        Margin="0,5,0,0"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Cursor="Hand"
                                                        ToolTip="{DynamicResource CommunicationOpenFileLocation}">
                                                    <TextBlock Text="{Binding FilePath}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DrillAccentBrush}"
                                                               TextDecorations="Underline"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Button>

                                                <Border Margin="0,7,0,0"
                                                        Padding="9,7"
                                                        Background="{DynamicResource DrillSubtleBrush}"
                                                        CornerRadius="5">
                                                    <TextBlock Text="{Binding PayloadJson}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource DrillTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                                <TextBlock Text="{Binding StateDetail}"
                                                           Margin="0,5,0,0"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource DrillDangerBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Control Width="26"
                                         Height="26"
                                         Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                         HorizontalAlignment="Center"
                                         Template="{StaticResource TerminalVectorIconTemplate}" />
                                <TextBlock Text="{DynamicResource CommunicationTerminalEmpty}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                           TextAlignment="Center" />
                            </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="FirstRegionSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ShowsPreview="True" />

            <local:WorkflowValidationPanel x:Name="ValidationRegion"
                                           Grid.Column="2"
                                           DataContext="{Binding ValidationDataContext, ElementName=Root}" />

            <GridSplitter x:Name="SecondRegionSplitter"
                          Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ShowsPreview="True" />

            <!-- The preview has one command header; connection state and commands no longer
                 float over the image or repeat in a footer. -->
            <Border x:Name="PreviewRegion"
                    Grid.Column="4"
                    Background="{DynamicResource DrillSurfaceBrush}"
                    BorderBrush="{DynamicResource DrillBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            MinHeight="42"
                            Padding="10,6"
                            Background="{DynamicResource DrillSurfaceBrush}"
                            BorderBrush="{DynamicResource DrillBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Control Grid.Column="0"
                                     Grid.Row="0"
                                     Width="18"
                                     Height="18"
                                     Foreground="{DynamicResource DrillAccentBrush}"
                                     Margin="0,0,8,0"
                                     Template="{StaticResource PreviewVectorIconTemplate}" />
                            <TextBlock Grid.Column="1"
                                       Grid.Row="0"
                                       Text="{DynamicResource EquipmentScreenTitle}"
                                       Foreground="{DynamicResource DrillTextBrush}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <ui:Button Grid.Column="2"
                                       Grid.Row="0"
                                       Style="{StaticResource MonitorIconButtonStyle}"
                                       Command="{Binding TogglePreviewCommand}"
                                       Margin="0,0,6,0"
                                       ToolTip="{Binding PreviewToggleToolTip}"
                                       AutomationProperties.Name="{Binding PreviewToggleToolTip}">
                                <Control Width="18"
                                         Height="18"
                                         Foreground="{DynamicResource DrillTextBrush}"
                                         Template="{StaticResource PreviewToggleVectorIconTemplate}" />
                            </ui:Button>
                            <ui:Button Grid.Column="3"
                                       Grid.Row="0"
                                       Style="{StaticResource MonitorIconButtonStyle}"
                                       Command="{Binding OpenPopOutCommand}"
                                       ToolTip="{DynamicResource EquipmentScreenPopOut}"
                                       AutomationProperties.Name="{DynamicResource EquipmentScreenPopOut}">
                                <Control Width="18"
                                         Height="18"
                                         Foreground="{DynamicResource DrillTextBrush}"
                                         Template="{StaticResource PopOutVectorIconTemplate}" />
                            </ui:Button>

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="4"
                                  Margin="1,4,0,0"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Style="{StaticResource EquipmentStatusDotStyle}"
                                         Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConnectionStateText}"
                                           Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Background="{DynamicResource DrillOpaqueSurfaceBrush}">
                        <Image Source="{Binding LatestFrameSource}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPopOutOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Border MaxWidth="220"
                                Margin="12"
                                Padding="12,9"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DrillSurfaceBrush}"
                                BorderBrush="{DynamicResource DrillBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Text="{Binding PreviewMessage}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DrillSecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEmbeddedPreviewActive}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding HasLatestFrame}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
