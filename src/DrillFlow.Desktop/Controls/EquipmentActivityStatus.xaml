<UserControl x:Class="DrillFlow.Desktop.Controls.EquipmentActivityStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DrillFlow.Desktop.ViewModels"
             HorizontalAlignment="Right"
             VerticalAlignment="Stretch"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ConnectionDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource DrillSecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionState}"
                             Value="{x:Static viewModels:EquipmentScreenConnectionState.Connecting}">
                    <Setter Property="Fill" Value="{DynamicResource DrillWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}"
                             Value="{x:Static viewModels:EquipmentScreenConnectionState.Connected}">
                    <Setter Property="Fill" Value="{DynamicResource DrillSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}"
                             Value="{x:Static viewModels:EquipmentScreenConnectionState.Faulted}">
                    <Setter Property="Fill" Value="{DynamicResource DrillDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Padding="12,8"
            Background="{DynamicResource DrillSurfaceBrush}"
            BorderBrush="{DynamicResource DrillBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite">
            <TextBlock Text="{Binding PendingExchangeText}"
                       Foreground="{DynamicResource DrillSecondaryTextBrush}"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Border Width="1"
                    Height="12"
                    Margin="10,0"
                    Background="{DynamicResource DrillBorderBrush}"
                    VerticalAlignment="Center" />
            <Ellipse Style="{StaticResource ConnectionDotStyle}"
                     Margin="0,0,6,0"
                     IsHitTestVisible="False" />
            <TextBlock Text="{Binding ConnectionStateText}"
                       Foreground="{DynamicResource DrillSecondaryTextBrush}"
                       FontSize="11"
                       MaxWidth="180"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
