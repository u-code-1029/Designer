<UserControl x:Class="DrillFlow.Desktop.Controls.WorkflowValidationPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ControlTemplate x:Key="ValidationVectorIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="20" Height="20">
                    <Ellipse Canvas.Left="2.5"
                             Canvas.Top="2.5"
                             Width="15"
                             Height="15"
                             Stroke="{TemplateBinding Foreground}"
                             StrokeThickness="1.5" />
                    <Path Data="M6,10.5 L9,13.5 14.5,7.5"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource DrillSurfaceBrush}"
            BorderBrush="{DynamicResource DrillBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,8"
                    Background="{DynamicResource DrillOpaqueSurfaceBrush}"
                    BorderBrush="{DynamicResource DrillBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Control Grid.Column="0"
                             Width="20"
                             Height="20"
                             Foreground="{DynamicResource DrillAccentBrush}"
                             Margin="0,0,8,0"
                             Template="{StaticResource ValidationVectorIconTemplate}" />
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource WorkflowValidationResultsTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DrillTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding ValidationSummaryText}"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource DrillSecondaryTextBrush}"
                               VerticalAlignment="Center" />
                    <ui:Button Grid.Column="3"
                               Command="{Binding ValidateCommand}"
                               ToolTip="{DynamicResource Validate}"
                               AutomationProperties.Name="{DynamicResource Validate}">
                        <Control Width="18"
                                 Height="18"
                                 Foreground="{DynamicResource DrillTextBrush}"
                                 Template="{StaticResource ValidationVectorIconTemplate}" />
                    </ui:Button>
                </Grid>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ValidationIssues}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectValidationIssueCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch">
                            <Border Padding="12,9"
                                    Margin="8,4"
                                    Background="{DynamicResource DrillSubtleBrush}"
                                    BorderBrush="{DynamicResource DrillBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource DrillWarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DrillDangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding ActionAlias}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DrillTextBrush}" />
                                        <TextBlock Text="{Binding Message}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DrillTextBrush}" />
                                        <TextBlock Text="{Binding Path}"
                                                   Margin="0,3,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DrillSecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Control Width="28"
                         Height="28"
                         Foreground="{DynamicResource DrillSecondaryTextBrush}"
                         Template="{StaticResource ValidationVectorIconTemplate}" />
                <TextBlock Margin="0,8,0,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource DrillSecondaryTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource WorkflowValidationNotRun}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValidationCurrent}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource WorkflowValidationNoIssues}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasValidationIssues}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
