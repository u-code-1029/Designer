+                 Height="300"
+                 MinWidth="520"
+                 MinHeight="260"
+                 ResizeMode="NoResize"
+                 WindowStartupLocation="CenterScreen"
+                 ExtendsContentIntoTitleBar="True"
+                 WindowBackdropType="None">
